# Configuration du microservice "Reporting" (Azure Functions).
# Sur Azure : "Application settings" de la Function App. En local : docker-compose.yml.

# API interne du Core et cle de service correspondante (REPORTING_SERVICE_KEY du Core)
CORE_URL=http://localhost:8000
CORE_SERVICE_KEY=

# Cle exigee par /api/reports/* (en-tete X-API-Key) ; le Core l'utilise pour le PDF
REPORTING_API_KEY=

# File du service Notifications, pour la synthese hebdomadaire
EVENTS_STORAGE=
NOTIFICATIONS_QUEUE=notification-events

# Format NCRONTAB, en UTC : lundi 05:00 UTC = 06:00 ou 07:00 a Paris
WEEKLY_REPORT_SCHEDULE=0 0 5 * * 1
