# Configuration du microservice "Notifications" (Azure Functions).
# Sur Azure : "Application settings" de la Function App. En local : docker-compose.yml.

# Compte de stockage portant la file d'evenements et la table d'historique.
EVENTS_STORAGE=
NOTIFICATIONS_QUEUE=notification-events

# mailpit | acs | simulated
EMAIL_MODE=simulated
SMTP_HOST=localhost
SMTP_PORT=1025
EMAIL_FROM=HospiPlan <no-reply@hospiplan.local>

# Mode acs uniquement (Azure Communication Services)
ACS_CONNECTION_STRING=
ACS_SENDER_ADDRESS=

# Cle exigee par GET /api/notifications (en-tete X-API-Key)
NOTIFICATIONS_API_KEY=
