# Modele de configuration : copiez ce fichier en .env et renseignez les valeurs.
# Generer une cle Django :
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"

DJANGO_SECRET_KEY=
DJANGO_DEBUG=True

DB_NAME=hospiplandb
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Plateforme MCP (lien de connexion des conversations)
MCP_BASE_URL=http://localhost:4000
MCP_VERIFY_SECRET=

# Hotes acceptes (separes par des virgules). Sur Azure :
#   DJANGO_ALLOWED_HOSTS=app-hospiplan-core.azurewebsites.net
#   DJANGO_CSRF_TRUSTED_ORIGINS=https://app-hospiplan-core.azurewebsites.net
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=

# Microservice "Moteur de planning" (cle partagee avec microservices/engine)
# Generer : python -c "import secrets; print(secrets.token_urlsafe(32))"
ENGINE_URL=http://localhost:8001
ENGINE_API_KEY=
ENGINE_TIMEOUT_SECONDS=60

# File d'evenements (microservice Notifications). Vide = publication desactivee.
# En local, docker compose la renseigne automatiquement (Azurite).
EVENTS_STORAGE_CONNECTION_STRING=
EVENTS_QUEUE_NAME=notification-events

# Microservice "Notifications" (utilise par docker compose)
# EMAIL_MODE : mailpit | acs | simulated
EMAIL_MODE=mailpit
NOTIFICATIONS_API_KEY=
ACS_CONNECTION_STRING=
ACS_SENDER_ADDRESS=

# Microservice "Reporting"
#   REPORTING_API_KEY     : le Core -> Reporting (telechargement du PDF)
#   REPORTING_SERVICE_KEY : Reporting -> le Core (/api/internal/planning-report/)
REPORTING_URL=http://localhost:7072
REPORTING_API_KEY=
REPORTING_SERVICE_KEY=
